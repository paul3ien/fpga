S_0x1013645b0 .scope module, "counter_tb" "counter_tb" 2 3;
 .timescale -9 -12;
v0x101368140_0 .var "clk", 0 0;
v0x1013681e0_0 .net "count", 3 0, v0x101368000_0;  1 drivers
v0x101368280_0 .var "reset", 0 0;
S_0x1013628f0 .scope module, "dut" "counter" 2 10, 3 1 0, S_0x1013645b0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /OUTPUT 4 "count";
v0x101362a70_0 .net "clk", 0 0, v0x101368140_0;  1 drivers
v0x101368000_0 .var "count", 3 0;
v0x1013680a0_0 .net "reset", 0 0, v0x101368280_0;  1 drivers
E_0xb02c34180 .event posedge, v0x101362a70_0;
    .scope S_0x1013628f0;
T_0 ;
    %wait E_0xb02c34180;
    %load/vec4 v0x1013680a0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x101368000_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x101368000_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x101368000_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x1013645b0;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x101368140_0;
    %inv;
    %store/vec4 v0x101368140_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x1013645b0;
T_2 ;
    %vpi_call 2 22 "$dumpfile", "counter.vcd" {0 0 0};
    %vpi_call 2 23 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x1013645b0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x101368140_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x101368280_0, 0, 1;
    %delay 20000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x101368280_0, 0, 1;
    %delay 160000, 0;
    %vpi_call 2 38 "$finish" {0 0 0};
    %end;
    .thread T_2;
